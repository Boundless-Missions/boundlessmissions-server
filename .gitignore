# Git version control
.git/

# Environment secrets – NEVER commit these.
# `.env.*` as well as `.env`: a literal `.env` did not cover the hand-made backups
# that accumulate next to it (`.env.bak-precheatflag` was a full copy of the live
# file, untracked by luck rather than by rule). The example is re-included after,
# since it is the one variant that must be committed.
.env
.env.*
!.env.example
firebase-key.json
*-adminsdk-*.json
*.json.key

# User data (persistent but not committed)
data/*.json
data/*.tmp

# Python bytecode & cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Databases (if added later)
*.db
*.sqlite
*.sqlite3

# Agent guidance for the GK-DW workspace, filter-out for possible private information
/CLAUDE.md
