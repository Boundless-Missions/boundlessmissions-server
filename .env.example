# ─────────────────────────────────────────────
#  Discord Bot – Environment Variables Template
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── Discord ──────────────────────────────────
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# ── Guild / Server ────────────────────────────
# NOTE: GUILD_IDS is NOT an allowlist and never was — the set of guilds the bot
# will operate in is hardcoded in `guild_gate.py`, on purpose (an allowlist that
# lives in config is one a bad .env can empty). Command sync now follows that
# allowlist too, so this var is vestigial and is read by nothing.
GUILD_IDS=

# Extra guild IDs to ADD to the hardcoded allowlist, comma-separated — for a dev
# or staging server. Additive only: it cannot remove the hardcoded guild. An
# unparseable entry is dropped with a warning rather than stopping the boot.
EXTRA_ALLOWED_GUILD_IDS=

# Whether the boot sweep LEAVES guilds that are not on the allowlist.
# Off by default and deliberately so: leaving destroys that server's corps
# channels, open tickets and guild_config, and a restart is the wrong place to
# make that call. While it is off the bot stays in such a guild but refuses every
# command, button and modal there. Guilds JOINED after startup are always left
# immediately regardless of this setting — a fresh join has no state to lose.
GUILD_GATE_LEAVE_ON_BOOT=false

# Restrict THIS instance to members holding specific roles — for a dev or testing
# bot sharing a guild with the live one. Off by default: the shipped behaviour is
# to answer every member, and the live bot must never be narrowed by a file that
# failed to load.
#
# Covers slash commands, autocomplete, buttons, modals and prefix commands. It can
# only ever narrow what the guild allowlist above already permits, never widen it.
#
# Two accounts always pass: the BOT_OWNER_ID (so a mistyped role id cannot lock the
# owner out of the bot that would fix it) and anyone pressing a button in a DM (a DM
# carries no roles at all, and refusing one breaks the contract hand-off buttons
# rather than closing a hole).
#
# Turning it ON with ALLOWED_ROLE_IDS empty makes this instance refuse EVERY member
# — that is what it says, and the boot log says so at ERROR level. It is not read
# as "off".
ROLE_GATE_ENABLED=false
# Comma-separated role IDs this instance answers. Only read when ROLE_GATE_ENABLED
# is true. An unparseable entry is dropped with a warning; unlike the guild list,
# dropping one here can only make the gate narrower.
#
# Note: Discord gives @everyone the same id as the guild, and every member holds it —
# so pasting a GUILD id in here opens the gate to the whole server rather than
# restricting it. Use a real tester role.
ALLOWED_ROLE_IDS=

# ── Home guild ────────────────────────────────
# The guild an account with no Discord of its own belongs to: where its tickets
# are opened and whose config answers for it. Blank/0 means "not configured",
# which callers must read as "no Discord surface available", never as guild 0.
HOME_GUILD_ID=

# ── Prefix ───────────────────────────────────
COMMAND_PREFIX=/

# ── Bot Settings ─────────────────────────────
BOT_OWNER_ID=your_discord_user_id_here

# ── Slash Command Group ───────────────────────
# Namespace all slash commands under a group to avoid clashing with other bots.
# e.g. COMMAND_GROUP=gk  →  /gk help, /gk ping, /gk kick
# Leave blank for bare top-level commands  (/help, /ping, /kick)
COMMAND_GROUP=g

# ── Roles ────────────────────────────────────
# Role pinged when a player files a bug report from the KSP mod's Tools tab. It
# gets access to the ticket and is pinged INSTEAD of the mod role — bug reports
# go to whoever maintains the bot/mod, not to moderation. Leave blank to fall
# back to the mod role. Can also be set per server with /admin setrole.
BUG_REPORT_ROLE_ID=

# ── Feature Flags ────────────────────────────
# Set to false to disable all moderation commands (kick, ban, mute, etc.)
ENABLE_MOD_COMMANDS=true

# ── Firebase / Firestore ─────────────────────
# Path to your Firebase service account JSON key file
# Get this from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_CREDENTIALS=firebase-key.json

# ── Firebase Storage ─────────────────────────
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# ── Gemini AI ────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Economy ──────────────────────────────────
# Coins a brand-new player's wallet is created with. 0 turns the grant off.
# Paid at record creation only, so changing it never touches an existing wallet,
# and it is the one thing in the economy that creates coins from nothing. Note
# that a record is created for every Discord member the bot can see, not only
# for people who install the mod. See settings.py for the full explanation.
STARTING_BALANCE=1000

# ── Cost guard: spend tracking + spending brake ──────────────────────────────
# Tracks what Gemini and Firebase cost each month and degrades/stops the bot as
# the budget runs down. Every value here is optional — the defaults in
# settings.py are sane. See settings.py for the full explanation.
COST_GUARD_ENABLED=true
# Monthly budgets in USD; 0 means unlimited (never capped).
FIREBASE_MONTHLY_BUDGET_USD=10
GEMINI_MONTHLY_BUDGET_USD=5
# The ladder: fraction of budget at which the owner is warned, and at which new
# Storage uploads start being refused. 100% is the full stop.
COST_WARN_FRACTION=0.5
COST_DEGRADE_FRACTION=0.8
#
# Authoritative usage from Cloud Monitoring. This is what sees direct-download
# egress, bytes at rest, and usage that isn't the bot — without it the guard runs
# on its in-process estimate alone and the figures read low.
#
#   ONE-TIME SETUP: grant the FIREBASE_CREDENTIALS service account
#   `roles/monitoring.viewer` on the project. Firebase does not grant it, and
#   until it exists every poll is denied (the bot says so, and keeps working).
#
# The poll interval is the only dial that affects what the tracker itself costs:
# Monitoring read calls are billed with a large monthly free allotment, and 300s
# uses well under 1% of it.
COST_METRICS_ENABLED=true
COST_METRICS_POLL_INTERVAL=300
#
# Actual billed dollars from the BigQuery billing export. DISPLAY ONLY — it is
# hours behind, so it never drives the brake; it is the receipt next to the
# estimate. Free-tier allowances arrive as credits, so this is the real invoice
# rather than a model of one.
#
#   SETUP: Billing → Billing export → BigQuery export → Standard usage cost,
#   pointed at a dataset (it never backfills, so enable it early). Then grant the
#   service account `roles/bigquery.dataViewer` on that dataset and
#   `roles/bigquery.jobUser` on the project — the Monitoring grant does not
#   cover BigQuery. Leave COST_BILLING_DATASET empty to switch this tier off.
COST_BILLING_ENABLED=true
COST_BILLING_DATASET=
COST_BILLING_POLL_INTERVAL=21600
# Hard cap on bytes scanned per query — the job is rejected rather than run if it
# would exceed this, so a wrong predicate cannot run up a bill.
COST_BILLING_MAX_BYTES=100000000

# ── KSP API Server ───────────────────────────
# REST API for KSP mod ↔ Discord bridge (runs in-process with the bot)
KSP_API_ENABLED=true
API_HOST=0.0.0.0
API_PORT=5022
# REQUIRED when KSP_API_ENABLED=true. Signs KSP session tokens — a known/default
# value lets anyone forge a login for any user, so the bot refuses to start with
# a placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
API_SECRET_KEY=your_random_secret_here
# Key rotation: to rotate API_SECRET_KEY without logging every player out,
# move the old key here, put a fresh key in API_SECRET_KEY, and restart. Old
# tokens keep verifying against this key while new ones are signed with the
# new key; clear it after 30 days (max token lifetime). Leave blank normally.
API_SECRET_KEY_PREVIOUS=
# Discord DM login approval for KSP linking. On by default. Set to false to skip
# the approval step while testing.
KSP_2FA_ENABLED=true
# Device binding: bind each install's random device id to the account and block
# any other device (e.g. a copied session token) until approved from Discord.
# On by default. Set to false to disable. Note: collecting MAC/IP/KSP.log in the
# moderation report requires disclosure in your ToS/Privacy Policy.
KSP_DEVICE_BINDING_ENABLED=true
# Mod version gate. On by default. The KSP client reports its DLL's SHA256 and the
# server blocks outdated clients in-game until they update. Publish a version with
# the /admin publishversion command. Set to false to disable the gate entirely.
# (With no version published yet, nothing is ever blocked regardless of this flag.)
KSP_VERSION_CHECK_ENABLED=true
# Cheat disqualification. On by default: a contract submission whose in-game cheat
# watchdog flagged the vessel (HyperEdit, VesselMover, F12 Set Position/Set Orbit,
# or F12 cheat toggles left on in flight) is refused with the reasons. A cheat
# tool merely being installed never disqualifies, and older clients sending no
# report are never rejected. Set to false to accept such submissions (they still
# face the issuer's / AI review).
KSP_CHEAT_DISQUALIFY_ENABLED=true
# Interactive API docs (Swagger UI + OpenAPI schema at /api/docs). Off by default
# so the endpoint list isn't exposed publicly; set true only for local dev.
API_DOCS_ENABLED=false
# Debug/test-only endpoints (e.g. /api/v1/debug/signtest, used by the KSP debug
# test panel to verify the signed-URL invariant). 404 when off. Turn on ONLY on a
# dev server to run the in-game live security tests; never in production.
DEBUG_ENDPOINTS_ENABLED=false

# The "Open a Ticket" panel embed, auto-posted into each guild's configured ticket
# panel channel at startup and by /ticketpanel. On by default.
#
# Set to false on any instance that shares a guild with another one — a dev or
# testing bot running next to the live bot. The auto-post only recognises a panel
# THIS bot user posted, so a second bot cannot see the live one, posts a duplicate
# under it, and then serves that duplicate's button — real tickets end up opened
# against the test bot.
TICKET_PANEL_ENABLED=true

# Multiplayer account API (/api/v1/mp/*): publishes the public signing keys and
# mints short-lived player tokens for game servers. Default off — while off
# every /mp/ route answers 404, so an unfinished surface is invisible rather
# than merely closed. Turn on only when there is a server to talk to.
MULTIPLAYER_ENABLED=false
# Browser CORS allow-list (comma-separated origins). Leave blank — the KSP client
# is not a browser and needs no CORS. Set origins only for a browser front-end.
API_CORS_ORIGINS=
# ── Public deployment (leave blank for localhost) ──
# Behind a TLS-terminating reverse proxy (recommended): list the proxy's IP so
# the real client IP is read from X-Forwarded-For for rate limiting, and bind the
# API to localhost (API_HOST=127.0.0.1) so only the proxy can reach it.
# IMPORTANT: if you run behind a proxy and leave this blank, every request's peer
# is the proxy, so all clients share ONE rate-limit bucket — one user hitting a
# limit then locks everyone out. Always set it when a proxy is in front.
API_TRUSTED_PROXIES=
# Direct HTTPS without a proxy: set BOTH to a cert and key (PEM). Leave blank to
# serve plain HTTP (localhost, or when a proxy terminates TLS).
API_SSL_CERTFILE=
API_SSL_KEYFILE=

# ── Logging ──────────────────────────────────
LOG_LEVEL=INFO   # DEBUG | INFO | WARNING | ERROR
